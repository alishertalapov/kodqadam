{
  "name": "kodqadam",
  "productName": "KodQadam",
  "version": "1.0.0",
  "description": "КодҚадам — Python бойынша үй жұмысы платформасы",
  "author": "KodQadam",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kz.kodqadam.app",
    "productName": "KodQadam",
    "files": [
      "main.js",
      "app-config.json",
      "icon.png",
      "offline.html",
      "afterPack.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "КодҚадам",
      "artifactName": "KodQadam-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "artifactName": "KodQadam-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "./afterPack.js"
  }
}